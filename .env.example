# Copy to .env for `netlify dev`. Never commit real keys.
# Both are optional: without them the app runs on simulated Qloo data and the scripted planner.
QLOO_HACKATHON_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides
# QLOO_API_BASE=https://hackathon.api.qloo.com
# CULTURERISK_MODEL=claude-opus-5-5
# CULTURERISK_EFFORT=medium
# CULTURERISK_MAX_STEPS=10
